<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniya's Store</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f4f4;
            text-align: center;
            margin: 0;
        }

        header {
            background: #222;
            color: white;
            padding: 20px;
        }

        .products {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
        }

        .product {
            background: white;
            margin: 15px;
            padding: 20px;
            width: 200px;
            border-radius: 10px;
        }

        button {
            background: #008060;
            color: white;
            padding: 10px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        #cart {
            background: white;
            margin: 20px;
            padding: 20px;
        }
    </style>
</head>

<body>

<header>
    <h1>Iniya's Store</h1>
    <p>Discover useful products at great prices!</p>
</header>

<h2>Our Products</h2>

<div class="products">

    <div class="product">
        <h3>T-Shirt</h3>
        <p>Price: ₹499</p>
        <button onclick="addToCart('T-Shirt',499)">
            Add to Cart
        </button>
    </div>

    <div class="product">
        <h3>Shoes</h3>
        <p>Price: ₹1299</p>
        <button onclick="addToCart('Shoes',1299)">
            Add to Cart
        </button>
    </div>

    <div class="product">
        <h3>Backpack</h3>
        <p>Price: ₹799</p>
        <button onclick="addToCart('Backpack',799)">
            Add to Cart
        </button>
    </div>

</div>

<div id="cart">
    <h2>Shopping Cart</h2>
    <div id="cartItems">Your cart is empty.</div>
    <h3 id="total">Total: ₹0</h3>
    <button onclick="checkout()">Place Order</button>
</div>

<script>
    let cart = [];

    function addToCart(name, price) {
        let item = cart.find(product => product.name === name);

        if (item) {
            item.quantity++;
        } else {
            cart.push({
                name: name,
                price: price,
                quantity: 1
            });
        }

        displayCart();
    }

    function displayCart() {
        let cartItems = document.getElementById("cartItems");
        let total = 0;

        cartItems.innerHTML = "";

        if (cart.length === 0) {
            cartItems.innerHTML = "Your cart is empty.";
        }

        cart.forEach((item, index) => {
            total += item.price * item.quantity;

            cartItems.innerHTML += `
                <p>
                    ${item.name} -
                    ₹${item.price} × ${item.quantity}
                    <button onclick="removeItem(${index})">
                        Remove
                    </button>
                </p>
            `;
        });

        document.getElementById("total").innerText =
            "Total: ₹" + total;
    }

    function removeItem(index) {
        cart.splice(index, 1);
        displayCart();
    }

    function checkout() {
        if (cart.length === 0) {
            alert("Your cart is empty!");
            return;
        }

        alert("Order placed successfully!");
        cart = [];
        displayCart();
    }
</script>

</body>
</html>
